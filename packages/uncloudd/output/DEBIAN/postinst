#!/bin/bash
set -e

if [ "$1" = "configure" ]; then
    adduser --system --home /var/lib/uncloud --shell /usr/sbin/nologin --group uncloud || true
    systemctl daemon-reload

    # Releases before the upstream socket-activation change shipped the unit as
    # uncloudd.service. Upstream (and `uc machine logs`) use uncloud.service, so
    # drop any leftover enablement of the old name.
    rm -f /etc/systemd/system/multi-user.target.wants/uncloudd.service

    systemctl enable uncloud.socket uncloud.service
    systemctl start uncloud.socket uncloud.service || true

    echo ""
    echo "================================================================"
    echo " WARNING: This release of uncloud contains breaking changes."
    echo " Please refer to the uncloud release notes before proceeding:"
    echo " https://github.com/psviderski/uncloud/releases"
    echo "================================================================"
    echo ""
fi

